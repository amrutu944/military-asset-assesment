PORT=5000
# Leave MONGO_URI empty (or set USE_MEMORY_DB=true) to use an embedded in-memory MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/milasset
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=1d
# Insert demo users and history when the ledger is empty
SEED_DEMO=true
# Optional: comma-separated list of allowed origins when the client is hosted elsewhere
# CLIENT_ORIGIN=https://your-frontend.example.com
